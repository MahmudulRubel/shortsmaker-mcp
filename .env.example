# ========================================================
# ShortsMaker MCP - Environment Variables (ALL OPTIONAL!)
# ========================================================
# ShortsMaker works 100% FREE out of the box in Local Mode ($0 cost, no API keys needed).
# To unlock high-speed cloud transcription, multimodal reasoning, or AI B-Roll,
# add any of your favorite API keys below:

# 1. Groq (Recommended for lightning-fast Whisper + Llama 3.3 70B in seconds!)
# https://console.groq.com/keys
GROQ_API_KEY=

# 2. OpenAI (Whisper-1, GPT-4o / GPT-4o-mini, DALL-E 3)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 3. Google Gemini (Gemini 1.5 Flash / Pro)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. Anthropic (Claude 3.5 Sonnet / Haiku)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# 5. Deepgram (Nova-2 Speech-to-Text)
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# 6. Replicate (Incredibly-Fast-Whisper, Llama 3, Flux Schnell)
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
